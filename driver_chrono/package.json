{
  "name": "driver_chrono",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "update-ip": "node ./scripts/update-env-ip.js",
    "test": "jest",
    "eas-build-post-install": "node ./scripts/eas-reinject-mapbox-gradle-properties.js",
    "postinstall": "patch-package && node scripts/apply-mapbox-navigation-patch.js && node scripts/verify-rnmapbox-android-patch.js",
    "fix-reroute": "node scripts/fix-mapbox-reroute-latency.js",
    "prestart": "npm run update-ip",
    "start": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true expo run:android",
    "ios": "node scripts/fix-assets-car.js ./ios; BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true expo run:ios",
    "web": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true expo start --web",
    "lint": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true expo lint",
    "release:ios": "npx eas-cli@18.11.0 build --platform ios --profile production --auto-submit"
  },
  "dependencies": {
    "@driveapp/expo-plugin-pod-disable-paths": "^0.0.2",
    "@expo/vector-icons": "^15.0.3",
    "@fleetbase/react-native-mapbox-navigation": "https://github.com/fleetbase/react-native-mapbox-navigation/archive/refs/heads/main.tar.gz",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@rnmapbox/maps": "^10.2.10",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.77.0",
    "dotenv": "~16.4.5",
    "expo": "~55.0.0",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-build-properties": "~55.0.16",
    "expo-camera": "~55.0.21",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-location": "~55.1.12",
    "expo-modules-core": "^55.0.25",
    "expo-network": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-speech": "~55.0.16",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.20",
    "expo-task-manager": "~55.0.18",
    "expo-web-browser": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "^55.0.24",
    "baseline-browser-mapping": "^2.9.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "private": true
}
